{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SolarJEPA P1 execution summary (result.json)",
  "description": "Foundation smoke only. artifacts.json separately indexes every published JSON artifact by bytes/SHA-256.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "role", "phase_e", "status", "execution_id", "experiment_ids", "fingerprints", "started_utc", "finished_utc", "output", "dataset_role", "code_commit", "code_branch", "seeds", "seed_policy", "models", "attempted_model_partition_scores", "successful_model_partition_scores", "failure_count", "evaluation", "deferred", "artifacts"],
  "properties": {
    "schema_version": {"const": 1},
    "role": {"const": "foundation_smoke_not_scientific_skill"},
    "phase_e": {"const": "BLOCKED_FOR_PHASE_E"},
    "status": {"enum": ["complete", "complete_with_model_failures", "failed"]},
    "execution_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
    "experiment_ids": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["seed", "fingerprint"], "properties": {"seed": {"type": "integer", "minimum": 0}, "fingerprint": {"$ref": "#/$defs/sha256"}}}},
    "fingerprints": {"type": "object", "additionalProperties": false, "required": ["config", "dataset", "split", "source"], "properties": {"config": {"$ref": "#/$defs/sha256"}, "dataset": {"$ref": "#/$defs/sha256"}, "split": {"$ref": "#/$defs/sha256"}, "source": {"$ref": "#/$defs/sha256"}, "training": {"$ref": "#/$defs/sha256", "description": "Computed effective training support identity; emitted by corrected producers, optional for historical v1 records."}}},
    "started_utc": {"type": "string", "format": "date-time"},
    "finished_utc": {"type": "string", "format": "date-time"},
    "output": {"type": "string", "pattern": "^results/experiments/[A-Za-z0-9][A-Za-z0-9_.-]*$"},
    "dataset_role": {"enum": ["synthetic_fixture", "goes_reference"]},
    "code_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "code_branch": {"type": "string"},
    "seeds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
    "seed_policy": {"type": "object", "additionalProperties": false, "required": ["fixture_seed", "model_seeds_used_for_randomness", "explanation"], "properties": {"fixture_seed": {"type": ["integer", "null"], "minimum": 0}, "model_seeds_used_for_randomness": {"const": false}, "explanation": {"type": "string"}}},
    "models": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "parameters"], "properties": {"name": {"enum": ["persistence", "training_mean", "trailing_mean", "drift", "ar1", "direct_ridge"]}, "parameters": {"type": "object"}}}},
    "attempted_model_partition_scores": {"type": "integer", "minimum": 0},
    "successful_model_partition_scores": {"type": "integer", "minimum": 0},
    "failure_count": {"type": "integer", "minimum": 0},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["trajectory", "schema_version", "events"], "properties": {"trajectory": {"const": "native_units_common_target_mask"}, "schema_version": {"const": 1}, "events": {"const": "not_constructed_real_event_definitions_gated"}}},
    "deferred": {"type": "object", "additionalProperties": false, "required": ["arch_garch", "solexs", "neural_training", "novelty"], "properties": {"arch_garch": {"const": "deferred_pending_residual_diagnostics"}, "solexs": {"const": "BLOCKED_FOR_PHASE_E"}, "neural_training": {"const": "not_implemented"}, "novelty": {"const": "UNKNOWN"}}},
    "artifacts": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z_]+\\.json$"}}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
